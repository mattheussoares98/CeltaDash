rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /enterprises/{enterpriseId} {
      function existingSubEnterprisesArePreserved() {
        return !('subEnterprises' in resource.data)
          || resource.data.subEnterprises == null
          || (
            resource.data.subEnterprises is list
            && request.resource.data.subEnterprises is list
            && request.resource.data.subEnterprises.size()
              >= resource.data.subEnterprises.size()
            && request.resource.data.subEnterprises.hasAll(
              resource.data.subEnterprises
            )
          );
      }

      function authenticatedUpdateIsValid() {
        return request.auth != null
          && request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly(['baseUrl', 'subEnterprises'])
          && (
            !('subEnterprises' in resource.data)
            || resource.data.subEnterprises == null
            || (
              request.resource.data.subEnterprises is list
              && resource.data.subEnterprises is list
              && request.resource.data.subEnterprises.size()
                >= resource.data.subEnterprises.size()
            )
          );
      }

      function unauthenticatedUpdateOnlyAddsSubEnterprises() {
        return request.auth == null
          && request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly(['subEnterprises'])
          && 'subEnterprises' in request.resource.data
          && request.resource.data.subEnterprises is list
          && existingSubEnterprisesArePreserved();
      }

      allow read: if true;
      allow create: if request.auth != null;

      allow update: if authenticatedUpdateIsValid()
        || unauthenticatedUpdateOnlyAddsSubEnterprises();

      allow delete: if false;
    }

    // Preserve the current behavior for other top-level collections,
    // without bypassing the enterprise restrictions.
    match /{collection}/{document=**} {
      allow read, write: if collection != 'enterprises';
    }
  }
}
